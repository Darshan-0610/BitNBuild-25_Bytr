/** Main App Component with Authentication Flow */
const App = () => {
    const { db, auth, userId, isLoading } = useFirebase();
    const { role } = useNourishUserData(db, userId);
    
    if (isLoading || (userId && role === null)) {
        // Show loading screen while Firebase loads or while the user's role is being fetched after login/signup
        return <div className="flex items-center justify-center min-h-screen"><LoadingSpinner /></div>;
    }

    // --- Authentication Check ---
    if (!userId) {
        // If no user is logged in, show the Auth Screen
        return <AuthScreen auth={auth} db={db} setIsLoading={isLoading => {}} appId={appId} />;
    }

    // --- Main Application based on Role ---
    if (role === 'Vendor') {
        return <VendorDashboard db={db} userId={userId} auth={auth} />;
    }
    
    // Default to Consumer if role is 'Consumer' or missing
    return <ConsumerApp db={db} userId={userId} auth={auth} />;
};

export default App;
