import React, { useState, useEffect, useCallback, useMemo } from 'react';
import { initializeApp } from 'firebase/app';
import { 
    getAuth, onAuthStateChanged, signOut,
    createUserWithEmailAndPassword, signInWithEmailAndPassword, 
    signInAnonymously, signInWithCustomToken // Kept for environment initialization
} from 'firebase/auth';
import { 
    getFirestore, collection, doc, onSnapshot, query, where, 
    setDoc, updateDoc, arrayUnion, arrayRemove, getDoc
} from 'firebase/firestore';

// --- Global Variables (Mandatory for Canvas Environment) ---
const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : {};
const initialAuthToken = typeof __initial_auth_token !== 'undefined' ? __initial_auth_token : null;
const appId = typeof __app_id !== 'undefined' ? __app_id : 'default-nourishnet-app';

// --- Core Firebase Initialization and Hooks ---

let app;
let dbInstance;
let authInstance;

const useFirebase = () => {
    const [db, setDb] = useState(null);
    const [auth, setAuth] = useState(null);
    const [userId, setUserId] = useState(null);
    const [isLoading, setIsLoading] = useState(true);

    useEffect(() => {
        try {
            if (Object.keys(firebaseConfig).length === 0) {
                console.error("Firebase config is missing.");
                setIsLoading(false);
                return;
            }
            
            app = initializeApp(firebaseConfig);
            dbInstance = getFirestore(app);
            authInstance = getAuth(app);
            
            setDb(dbInstance);
            setAuth(authInstance);

            const unsubscribe = onAuthStateChanged(authInstance, async (user) => {
                if (user) {
                    setUserId(user.uid);
                } else {
                    setUserId(null); // User is logged out
                    // Attempt initial sign-in if token is present (environment setup)
                    if (initialAuthToken) {
                        try {
                            await signInWithCustomToken(authInstance, initialAuthToken);
                        } catch (error) {
                            console.error("Initial sign-in failed:", error);
                        }
                    }
                }
                setIsLoading(false);
            });

            return () => unsubscribe();

        } catch (error) {
            console.error("Error initializing Firebase:", error);
            setIsLoading(false);
        }
    }, []);

    return { db, auth, userId, isLoading };
};

// Custom hook to fetch user data (including role)
const useNourishUserData = (db, userId) => {
    const [userData, setUserData] = useState(null);
    const [role, setRole] = useState(null); // Role is null until loaded
    
    useEffect(() => {
        if (db && userId) {
            const userDocRef = doc(db, `artifacts/${appId}/users/${userId}/config/profile`);
            
            const unsubscribe = onSnapshot(userDocRef, (docSnap) => {
                if (docSnap.exists()) {
                    const data = docSnap.data();
                    setUserData(data);
                    setRole(data.role || 'Consumer'); // Default to Consumer if profile is missing role
                } else {
                    // Profile document does not exist yet (e.g., brand new user)
                    // The App component will wait for the role to be set on signup/login.
                    setRole(null);
                }
            }, (error) => {
                console.error("Error fetching user data:", error);
                setRole(null);
            });

            return unsubscribe;
        }
        setUserData(null);
        setRole(null);
    }, [db, userId]);

    return { userData, role };
};

// --- Data Fetching Hooks (Public Data: Menus & Deliveries) ---

const usePublicData = (db, collectionName) => {
    const [data, setData] = useState([]);
    const [isDataLoading, setIsDataLoading] = useState(true);

    useEffect(() => {
        if (db) {
            const publicCollectionRef = collection(db, `artifacts/${appId}/public/data/${collectionName}`);
            const q = query(publicCollectionRef);

            const unsubscribe = onSnapshot(q, (snapshot) => {
                const fetchedData = snapshot.docs.map(doc => ({
                    id: doc.id,
                    ...doc.data()
                }));
                setData(fetchedData);
                setIsDataLoading(false);
            }, (error) => {
                console.error(`Error fetching ${collectionName}:`, error);
                setIsDataLoading(false);
            });

            return unsubscribe;
        }
    }, [db, collectionName]);

    return { data, isDataLoading };
};


